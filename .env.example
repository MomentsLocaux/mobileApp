# Local default = DEV. For UAT: copy .env.uat.example → .env.uat (gitignored).
EXPO_PUBLIC_APP_ENV=dev

# Public mobile runtime values. These can be embedded in the Expo app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SUPABASE_AVATAR_BUCKET=avatar
EXPO_PUBLIC_SUPABASE_EVENT_COVER_BUCKET=event-media

# -----------------------------------------------------------------------------
# Feature flags — store-ready MVP defaults (restart Metro after change)
# Source of truth: src/config/features.ts
# -----------------------------------------------------------------------------

# MVP — peer social (default ON when unset; set false to hide)
# EXPO_PUBLIC_FEATURE_SOCIAL_PEERS=false

# V1 — off for discovery-only MVP
EXPO_PUBLIC_FEATURE_EVENT_CREATE=false
EXPO_PUBLIC_FEATURE_CHECKIN=false
EXPO_PUBLIC_FEATURE_OFFERS=false
EXPO_PUBLIC_FEATURE_DIFFUSEUR=false

# V2 — off for MVP (FEATURE_*=false wins over legacy aliases below)
EXPO_PUBLIC_FEATURE_GAMIFICATION=false
EXPO_PUBLIC_FEATURE_DISCOVERY=false
EXPO_PUBLIC_FEATURE_DISCOVERY_CAPTURE=false
EXPO_PUBLIC_FEATURE_CONTESTS=false

# Legacy aliases — keep false; ignored when FEATURE_* is set
EXPO_PUBLIC_GAMIFICATION_ENABLED=false
EXPO_PUBLIC_DISCOVERY_ENABLED=false
EXPO_PUBLIC_DISCOVERY_CAPTURE_ENABLED=false

# Native build/download tokens. Keep local or in CI secrets; do not expose with EXPO_PUBLIC_*.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
MAPBOX_DOWNLOADS_TOKEN=

# Required for Expo push tokens (eas init). Never commit the real value if sensitive.
EAS_PROJECT_ID=

# Server/admin only. Keep out of Expo public config and never prefix with EXPO_PUBLIC_.
# Required only for local admin scripts or Supabase Edge Function deployment/runtime secrets.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — Edge Function lumia-chat only (chat + embeddings). Never EXPO_PUBLIC_ / never commit the real key.
# Also set the same name as a Supabase Edge Function secret on moments-locaux-dev.
OPENAI_API_KEY=

# Public marketing site (invite share, etc.). Override per env when staging is live.
EXPO_PUBLIC_APP_SHARE_URL=https://moments-locaux.com

# QR code share/check-in landing (web HTTPS) used inside the QR image.
# DEV/UAT later: https://dev.moments-locaux.com or https://staging.moments-locaux.com
# Leave empty for now; app uses a placeholder base URL locally.
EXPO_PUBLIC_EVENT_QR_WEB_BASE_URL=

# For testing only: when true, the QR contains a custom scheme link
# (opens the app if installed). When false, the QR contains an HTTPS link
# intended for Universal/App Links (real site config later).
EXPO_PUBLIC_EVENT_QR_USE_APP_SCHEME=false

# Optional override of the scheme base used when EXPO_PUBLIC_EVENT_QR_USE_APP_SCHEME=true.
EXPO_PUBLIC_EVENT_QR_APP_BASE_URL=moments-locaux://events

# Roadtrip planner — off by default; set true + restart Metro to show /roadtrip
EXPO_PUBLIC_FEATURE_ROADTRIP=false

# Post-MVP — Lumia chat (default off; set true + restart Metro)
EXPO_PUBLIC_FEATURE_LUMIA_CHAT=false

# V1 — event suggestion from poster photo / flyer (independent from EVENT_CREATE)
EXPO_PUBLIC_FEATURE_EVENT_SUGGEST=true

# Server-only (Edge Function suggest-event-from-poster). Default 20/month if unset.
# Set as Supabase secret: EVENT_SUGGEST_MONTHLY_QUOTA=20
# EVENT_SUGGEST_MONTHLY_QUOTA=20
