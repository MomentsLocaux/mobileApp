{
  "expo": {
    "name": "Moments Locaux",
    "slug": "moments-locaux",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moments-locaux",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {},
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.momentslocs.app",
      "buildNumber": "4"
    },
    "android": {
      "package": "com.momentslocs.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/signature-b/app-icons/android-adaptive-foreground-1024.png",
        "monochromeImage": "./assets/brand/signature-b/app-icons/android-themed-monochrome-1024.png",
        "backgroundColor": "#F4FBF6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F4FBF6"
        }
      ],
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@rnmapbox/maps"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
